  "files": [
    "dist",
    "bin",
    "LICENSE.md",
    "NOTICE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "homepage": "https://hudsonkit.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/arach/hudson.git",
    "directory": "packages/web/hudsonkit"
  },
  "scripts": {
    "build": "bun run build:js && bun run build:css",
    "build:js": "tsup && tsup --config tsup.theme.config.ts && tsup --config tsup.server.config.ts",
    "build:css": "tailwindcss -i src/styles/bundle.css -o dist/styles.css --minify && cp src/styles/tokens.css dist/tokens.css && cp src/styles/styles.d.ts dist/styles.d.ts && cp src/styles/styles-tokens.d.ts dist/styles-tokens.d.ts && cp src/styles/agent-composer.css dist/agent-composer.css && cp src/styles/agent-composer-styles.d.ts dist/agent-composer-styles.d.ts && cp src/styles/agent-workspace.css dist/agent-workspace.css && cp src/styles/agent-workspace-styles.d.ts dist/agent-workspace-styles.d.ts",
    "assert-dist": "node bin/assert-dist.mjs",
    "pack": "bun run build && bun run assert-dist && bun pm pack && node bin/verify-pack.mjs",
    "prepare": "node bin/prepare-check.mjs",
    "test": "vitest run --config ./vitest.config.ts"
  },
